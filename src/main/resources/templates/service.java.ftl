package [=pkg];

<#list imports as i>
import [=i];
</#list>
<#assign proxy = options.proxy>
<#if resource.entity??>
import [=resource.entityFqn];
import [=resource.repositoryFqn];
</#if>
<#if proxy>
import org.springframework.core.ParameterizedTypeReference;
import org.springframework.http.HttpMethod;
<#else>
import [=exceptionPackage].ResourceNotFoundException;
import org.springframework.transaction.annotation.Transactional;
</#if>
import org.springframework.stereotype.Service;

/**
<#if resource.description?has_content>
 * [=doc(resource.description)]
 *
</#if>
 * Business logic for the "[=resource.name]" API group.
<#if proxy>
 * Every operation is delegated to the upstream API ([=api.upstreamUrl]) through {@link UpstreamClient};
 * add caching, mapping or extra rules around those calls as needed.
<#else>
 * Operations whose body only throws {@link UnsupportedOperationException} need your implementation.
</#if>
 *
 * [=generatedNote]
 */
@Service
<#if !proxy>
@Transactional
</#if>
public class [=resource.serviceName] {
<#if proxy>

    private final UpstreamClient upstream;

    public [=resource.serviceName](UpstreamClient upstream) {
        this.upstream = upstream;
    }
</#if>
<#if resource.entity??>

    private final [=resource.repositoryName] repository;

    public [=resource.serviceName]([=resource.repositoryName] repository) {
        this.repository = repository;
    }
</#if>
<#list resource.operations as op>

    /**
<#if op.summary?has_content>
     * [=doc(op.summary)]
</#if>
     * <p>[=op.httpMethod] [=op.fullPath]
    <#if op.kind != "CUSTOM">
     * <p>Implemented as a standard [=op.kind?lower_case] operation.
    </#if>
     */
<#if op.deprecated>
    @Deprecated
</#if>
    public [=op.returnType.java] [=op.method]([=op.signature()]) {
<#if proxy>
        <#if !op.returnsVoid>return </#if>this.upstream.call(HttpMethod.[=op.httpMethod], "[=op.path?j_string]")
<#list op.params as p>
<#if p.in == "path">
            .pathVariable("[=p.name?j_string]", [=p.javaName])
<#elseif p.in == "query">
            .query("[=p.name?j_string]", [=p.javaName])
<#elseif p.in == "header" && !p.contentTypeSelector>
            .header("[=p.name?j_string]", [=p.javaName])
<#elseif p.in == "cookie">
            .cookie("[=p.name?j_string]", [=p.javaName])
<#elseif p.in == "form" || p.in == "part">
            .part("[=p.name?j_string]", [=p.javaName])
</#if>
</#list>
<#if op.contentTypeExpr()?has_content>
            .contentType([=op.contentTypeExpr()])
</#if>
<#if op.body??>
            .body([=op.body.javaName])
</#if>
<#if op.produces?has_content>
            .accept("[=op.produces[0]?j_string]")
</#if>
<#if op.returnsVoid>
            .execute();
<#else>
            .retrieve(new ParameterizedTypeReference<[=op.returnType.java]>() {});
</#if>
<#elseif op.kind == "LIST">
        return repository.findAll();
<#elseif op.kind == "GET">
<#if op.lookupKind == "ID">
        return repository.findById([=op.lookupExpr])
<#else>
        return repository.[=op.finderMethod]([=op.lookupExpr])
</#if>
            .orElseThrow(() -> new ResourceNotFoundException("[=resource.entityClass] not found: " + [=op.lookupParam]));
<#elseif op.kind == "CREATE">
<#if resource.entity.idGeneration != "NONE">
        // the id is generated by the database; ignore any id sent by the client
        [=op.body.javaName].set[=resource.entity.idField.cap](null);
</#if>
<#if op.returnsVoid>
        repository.save([=op.body.javaName]);
<#else>
        return repository.save([=op.body.javaName]);
</#if>
<#elseif op.kind == "UPDATE">
<#if op.lookupKind == "ID">
        [=resource.entityClass] existing = repository.findById([=op.lookupExpr])
<#else>
        [=resource.entityClass] existing = repository.[=op.finderMethod]([=op.lookupExpr])
</#if>
            .orElseThrow(() -> new ResourceNotFoundException("[=resource.entityClass] not found: " + [=op.lookupParam]));
        [=op.body.javaName].set[=resource.entity.idField.cap](existing.get[=resource.entity.idField.cap]());
<#if op.returnsVoid>
        repository.save([=op.body.javaName]);
<#else>
        return repository.save([=op.body.javaName]);
</#if>
<#elseif op.kind == "DELETE">
<#if op.lookupKind == "ID">
        [=resource.entityClass] existing = repository.findById([=op.lookupExpr])
<#else>
        [=resource.entityClass] existing = repository.[=op.finderMethod]([=op.lookupExpr])
</#if>
            .orElseThrow(() -> new ResourceNotFoundException("[=resource.entityClass] not found: " + [=op.lookupParam]));
        repository.delete(existing);
<#else>
        // TODO implement: [=op.httpMethod] [=op.fullPath]
        throw new UnsupportedOperationException("[=op.method] is not implemented yet");
</#if>
    }
</#list>
}
