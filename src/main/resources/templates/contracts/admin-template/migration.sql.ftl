-- Module "[=module.name]", generated by SpecForge (admin-template@1) from "[=api.title]".
<#if module.createTables>
-- Tables are created with PostgreSQL types derived from the mapping, prefixed "[=module.tablePrefix]" so they never
-- collide with the project's own; foreign keys come last, so the order of the tables does not matter.
<#list module.entities as x>

create table [=x.ddlTable] (
    [=x.ddlIdColumn] [=x.ddlIdType] primary key<#if x.baseEntity>,
    version bigint not null default 0,
    created_at timestamptz not null default now(),
    updated_at timestamptz not null default now()</#if><#list x.columns as c>,
    [=c.ddlName] [=c.ddlType]<#if !c.nullable> not null</#if><#if c.ddlDefault?has_content> default [=c.ddlDefault]</#if></#list><#list x.relations as r>,
    [=r.ddlColumn] [=r.target.ddlKeyType]<#if !r.nullable> not null</#if></#list><#list x.uniques as u>,
    unique (<#list u as col>[=col]<#sep>, </#sep></#list>)</#list>
);
</#list>
<#list module.entities as x><#list x.manyToMany as j>

create table [=j.ddlJoinTable] (
    [=j.ddlJoinColumn] [=x.ddlKeyType] not null,
    [=j.ddlInverseJoinColumn] [=j.target.ddlKeyType] not null,
    primary key ([=j.ddlJoinColumn], [=j.ddlInverseJoinColumn])
);
</#list></#list>
<#list module.entities as x>
<#list x.relations as r>

alter table [=x.ddlTable] add foreign key ([=r.ddlColumn]) references [=r.target.ddlTable] ([=r.target.ddlIdColumn]);
create index on [=x.ddlTable] ([=r.ddlColumn]);
</#list>
<#list x.manyToMany as j>

alter table [=j.ddlJoinTable] add foreign key ([=j.ddlJoinColumn]) references [=x.ddlTable] ([=x.ddlIdColumn]) on delete cascade;
alter table [=j.ddlJoinTable] add foreign key ([=j.ddlInverseJoinColumn]) references [=j.target.ddlTable] ([=j.target.ddlIdColumn]) on delete cascade;
</#list>
</#list>
<#else>
-- The tables already exist in the project's database (SpecForge does not create or change them).
</#if>
<#if module.newPermission>

-- Changing [=module.name] data needs this permission (security/Permissions.java must list it too, see
-- backend/specforge-[=module.name].md). ADMIN holds every permission implicitly; <#if module.grantManagers>managers hold it too.<#else>other roles get it in the
-- Permissions screen.</#if>
insert into permission (code, area, position)
select '[=module.permission]', '[=module.permissionArea]', coalesce(max(position), 0) + 10 from permission;
<#if module.grantManagers>
insert into role_permission (role, permission_code) values ('MANAGER', '[=module.permission]');
</#if>
</#if>
<#if module.menuSection?has_content>

-- Menu entries under "[=module.menuSection]" (labels: the UI texts nav.<item_key>); visible to every user.
insert into menu_item (parent_id, item_key, href, icon, position)
select s.id, e.item_key, e.href, 'table_rows', coalesce((select max(position) from menu_item where parent_id = s.id), 0) + e.position
from menu_item s, (values
<#list module.entities as x>
        ('[=x.navKey]', '[=x.route]', [=(x?index + 1) * 10])<#sep>,</#sep>
</#list>
    ) as e (item_key, href, position)
where s.item_key = '[=module.menuSection]';
</#if>
